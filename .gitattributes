# Нормализация переводов строк: в репозитории — LF, кроме Windows-скриптов.
* text=auto

*.go      text eol=lf
*.kt      text eol=lf
*.kts     text eol=lf
*.gradle  text eol=lf
*.sh      text eol=lf
gradlew   text eol=lf
*.md      text eol=lf
*.json    text eol=lf
*.xml     text eol=lf

*.ps1     text eol=crlf
*.bat     text eol=crlf
*.cmd     text eol=crlf

# Бинарные
*.png binary
*.jar binary
*.aar binary
*.apk binary
*.exe binary
*.dll binary
*.zip binary
